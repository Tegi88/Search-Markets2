# Get a free API key (2 minutes, no credit card) at:
# https://site.financialmodelingprep.com/developer/docs/pricing
# Free tier: 250 requests/day. Financial statements, price history, and
# quote fallbacks are covered first by SEC EDGAR / Stooq / Yahoo (all free,
# no key needed), so FMP's quota is mainly spent on ratios, estimates,
# ownership, and news.
FMP_API_KEY=your_api_key_here

# Optional: identifies this app to SEC EDGAR's API, per their fair-use
# policy (https://www.sec.gov/os/webmaster-faq#developers). A descriptive
# string is enough; add your email if you expect heavy usage.
# SEC_EDGAR_USER_AGENT=SearchMarkets your_email@example.com
